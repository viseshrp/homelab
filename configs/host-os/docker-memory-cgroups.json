{
  "schema_version": 1,
  "purpose": "Enable Docker memory accounting used by Dozzle on Raspberry Pi OS hosts.",
  "hosts": {
    "rpimon": {
      "boot_file": "/boot/firmware/cmdline.txt",
      "required_parameters": [
        "cgroup_enable=memory"
      ],
      "cgroup_version": 2
    },
    "rpinfs": {
      "boot_file": "/boot/firmware/cmdline.txt",
      "required_parameters": [
        "cgroup_enable=memory",
        "cgroup_memory=1"
      ],
      "cgroup_version": 2
    }
  }
}
