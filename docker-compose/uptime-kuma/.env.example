# Copy to .env and fill private values before use. Blank required values prevent startup.
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:latest

# Private inputs used by reconcile.py. Keep real domains and LAN addresses out of Git.
UPTIME_KUMA_PUBLIC_DOMAIN=example.com
UPTIME_KUMA_HOST_OPTIPLEX=192.0.2.10
UPTIME_KUMA_HOST_RPIBLOG=192.0.2.11
UPTIME_KUMA_HOST_RPIHASS=192.0.2.12
UPTIME_KUMA_HOST_RPIHOLE=192.0.2.13
UPTIME_KUMA_HOST_RPIMON=192.0.2.14
UPTIME_KUMA_HOST_RPINFS=192.0.2.15
UPTIME_KUMA_HOST_RPIPROXY=192.0.2.16
UPTIME_KUMA_HOST_VPN_EDGE=192.0.2.17

# Private self-hosted ntfy destination managed by reconcile-notification.py.
UPTIME_KUMA_NTFY_SERVER_URL=https://ntfy.example.com
UPTIME_KUMA_NTFY_TOPIC=replace_with_random_topic
UPTIME_KUMA_NTFY_ACCESS_TOKEN=tk_00000000000000000000000000000
