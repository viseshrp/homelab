SCRUTINY_COLLECTOR_BASE=ghcr.io/analogj/scrutiny:v0.9.3-collector@sha256:9e3413b1992eee55cd4138a2e5b9083ce47f6f3ffce7d1c1eb17995c05728b3e
SCRUTINY_COLLECTOR_IMAGE=homelab/scrutiny-collector:v0.9.3
SCRUTINY_API_ENDPOINT=http://192.0.2.14:8083
SCRUTINY_HOST_ID=optiplex
SCRUTINY_COLLECTOR_CRON_SCHEDULE='15 3 * * *'
TZ=America/New_York

# Use stable whole-device paths for USB disks. The host-only values may include
# serial numbers and must stay out of Git. Map the NVMe controller, not a
# partition, so smartctl can issue admin commands.
SCRUTINY_DEVICE_MEDIA2=/dev/disk/by-id/usb-REPLACE_WITH_MEDIA2_DISK_ID
SCRUTINY_DEVICE_MEDIA3=/dev/disk/by-id/usb-REPLACE_WITH_MEDIA3_DISK_ID
SCRUTINY_DEVICE_SYSTEM=/dev/nvme0

# This token belongs to the matching Uptime Kuma push monitor. The collector
# sends one heartbeat after each scan; missing heartbeats reveal a dead job.
SCRUTINY_KUMA_PUSH_HOST=192.0.2.14
SCRUTINY_KUMA_PUSH_PORT=3001
SCRUTINY_KUMA_PUSH_TOKEN=REPLACE_WITH_RANDOM_PUSH_TOKEN
