# Generate the private values with configs/ntfy/generate-private.py. Do not copy
# these placeholders to a live host.
NTFY_IMAGE=binwiederhier/ntfy:latest
NTFY_BASE_URL=https://ntfy.example.com
NTFY_BIND_IP=192.0.2.14
NTFY_HTTP_PORT=2586
NTFY_UID=1000
NTFY_GID=1000
TZ=America/New_York
NTFY_CACHE_DURATION=72h
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# Private declarative auth inputs. The generated server denies anonymous access,
# gives Kuma, Scrutiny, FBN, and every DIUN host separate write-only access.
# FBN gets a separate topic; the mobile account can read both topics. For a new
# installation, run the base generator and then both extension helpers.
NTFY_AUTH_USERS='kuma-publisher:REPLACE_WITH_BCRYPT_HASH:user,scrutiny-publisher:REPLACE_WITH_BCRYPT_HASH:user,mobile-subscriber:REPLACE_WITH_BCRYPT_HASH:user,fbn-publisher:REPLACE_WITH_BCRYPT_HASH:user,diun-optiplex:REPLACE_WITH_BCRYPT_HASH:user,diun-rpiblog:REPLACE_WITH_BCRYPT_HASH:user,diun-rpihole:REPLACE_WITH_BCRYPT_HASH:user,diun-rpimon:REPLACE_WITH_BCRYPT_HASH:user,diun-rpinfs:REPLACE_WITH_BCRYPT_HASH:user,diun-rpiproxy:REPLACE_WITH_BCRYPT_HASH:user,diun-vpn-edge:REPLACE_WITH_BCRYPT_HASH:user,diun-rpihass:REPLACE_WITH_BCRYPT_HASH:user'
NTFY_AUTH_ACCESS='kuma-publisher:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,scrutiny-publisher:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,mobile-subscriber:REPLACE_WITH_RANDOM_MONITORING_TOPIC:ro,fbn-publisher:REPLACE_WITH_RANDOM_FBN_TOPIC:wo,mobile-subscriber:REPLACE_WITH_RANDOM_FBN_TOPIC:ro,diun-optiplex:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpiblog:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpihole:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpimon:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpinfs:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpiproxy:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-vpn-edge:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo,diun-rpihass:REPLACE_WITH_RANDOM_MONITORING_TOPIC:wo'
NTFY_AUTH_TOKENS='kuma-publisher:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:kuma,scrutiny-publisher:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:scrutiny,fbn-publisher:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:fbn,diun-optiplex:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-optiplex,diun-rpiblog:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpiblog,diun-rpihole:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpihole,diun-rpimon:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpimon,diun-rpinfs:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpinfs,diun-rpiproxy:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpiproxy,diun-vpn-edge:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-vpn-edge,diun-rpihass:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:diun-rpihass'
