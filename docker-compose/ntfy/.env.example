NTFY_IMAGE=binwiederhier/ntfy:v2.28.0@sha256:6ef4b819f722fccdc036af611c4774cfdc2de821ab74fdd48bbf4c9d6f8973da
NTFY_BASE_URL=https://ntfy.example.com
