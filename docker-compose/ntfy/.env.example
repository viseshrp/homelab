NTFY_UID=1000
NTFY_GID=1000
TZ=America/New_York
NTFY_CACHE_DURATION=72h
NTFY_UPSTREAM_BASE_URL=https://ntfy.sh

# Private declarative auth inputs. The generated server denies anonymous access,
# gives Kuma write-only access, and gives the mobile account read-only access.
NTFY_AUTH_USERS='kuma-publisher:REPLACE_WITH_BCRYPT_HASH:user,mobile-subscriber:REPLACE_WITH_BCRYPT_HASH:user'
NTFY_AUTH_ACCESS='kuma-publisher:REPLACE_WITH_RANDOM_TOPIC:wo,mobile-subscriber:REPLACE_WITH_RANDOM_TOPIC:ro'
NTFY_AUTH_TOKENS='kuma-publisher:tk_REPLACE_WITH_29_RANDOM_CHARACTERS:kuma'
