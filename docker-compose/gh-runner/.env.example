# Copy to .env and fill installation-specific values before use.
REPO_URL=https://github.com/example/blog
RUNNER_NAME=homelab-blog
# Needed only for first registration or replacement. Leave blank after the
# runner identity has been saved in RUNNER_CONFIG_DIR.
RUNNER_TOKEN=
RUNNER_WORKDIR=/tmp/runner
RUNNER_SCOPE=repo
LABELS=blog
WORKER_IMAGE=myoung34/github-runner:latest
RUNNER_CONFIG_DIR=./runner-config
RUNNER_CONFIG_CONTAINER_DIR=/runner-config
DISABLE_AUTOMATIC_DEREGISTRATION=true
UNSET_CONFIG_VARS=true
