# Copy to .env and fill private values before use. Blank required values prevent startup.
COMPOSE_FILE=docker-compose.yml
FBN_SOURCE_DIR=
# Generate this private token URL with configs/ntfy/add-fbn-publisher.py.
FBN_APPRISE_URL=ntfys://tk_REPLACE_WITH_29_RANDOM_CHARACTERS@ntfy.example.com/replace_with_random_fbn_topic?auth=token
FBN_GROUP=
FBN_AUTH_FILE=
FBN_DATA_VOLUME=fbn-monitor-data
FBN_TIMEZONE=America/New_York
FBN_EVERY=50m
FBN_TO=50m
FBN_UID=1000
FBN_GID=1000
