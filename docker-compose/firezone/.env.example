# Copy to .env and fill private values before use. Blank required values prevent startup.
FIREZONE_IMAGE=firezone/firezone:latest
POSTGRES_IMAGE=postgres:15
DATABASE_USER=postgres
DATABASE_NAME=firezone
DATABASE_PASSWORD=
DATABASE_HOST=postgres
EXTERNAL_URL=https://firezone.example.com
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
SECRET_KEY_BASE=
LIVE_VIEW_SIGNING_SALT=
COOKIE_SIGNING_SALT=
COOKIE_ENCRYPTION_SALT=
FZ_INSTALL_DIR=.
FZ_IPV6_ADDRESS=fd25:3990:3990::99
FZ_IPV6_SUBNET=fd25:3990:3990::/64
FZ_IPV6_GATEWAY=fd25:3990:3990::1
