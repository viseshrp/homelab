# DIUN 4.33.0 multi-architecture manifest. Review the release and platform
# manifests before changing this immutable reference.
DIUN_IMAGE=crazymax/diun:4.33.0@sha256:e324b793eb32dfb7f74d3a39421ebf090141caaadee69b8f78da63112408ee25
DIUN_HOSTNAME=example-docker-host
TZ=America/New_York

# Check at each six-hour boundary. Host-local jitter avoids synchronized requests.
DIUN_WATCH_SCHEDULE=0 */6 * * *
DIUN_WATCH_JITTER=45m
DIUN_WATCH_WORKERS=10
DIUN_WATCH_STOPPED=true
DIUN_LOG_LEVEL=info

# Use the private-LAN ntfy endpoint. The topic is private and must come from the
# ntfy publisher generator. The access token belongs in ./ntfy-token with mode
# 0600 and no trailing newline; it is never stored in this environment file.
DIUN_NTFY_ENDPOINT=http://192.0.2.14:2586
DIUN_NTFY_TOPIC=REPLACE_WITH_PRIVATE_TOPIC
DIUN_NTFY_PRIORITY=3

DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
