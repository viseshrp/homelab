# Copy to .env and fill private values before use. Blank required values prevent startup.
DOMAIN=https://pass.example.com
SMTP_HOST=smtp.example.com
SMTP_FROM=homelab@example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_TIMEOUT=15
SMTP_USERNAME=homelab@example.com
SMTP_PASSWORD=
VAULTWARDEN_IMAGE=vaultwarden/server:latest
