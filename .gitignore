# Editor and operating-system files
.idea/
.DS_Store

# Python environments and generated caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Private inputs. Commit the matching example or sanitized schema instead.
.env
.env.*
!.env.example
**/docker-compose.env
**/secrets.yaml
**/users.yml
**/cloudflare-credentials.ini
**/f2b-integration.json
**/*.private.*

# Local repository output
/local/
/build/

# Exact bind-mounted runtime paths. Keep these project-specific so a new
# service's declarative data/, config/, or public/ files remain visible to Git.
/docker-compose/anki/data/
/docker-compose/archivebox/data/
/docker-compose/blog/public/
/docker-compose/dozzle/data/
/docker-compose/fail2ban/data/
