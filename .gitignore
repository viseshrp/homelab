/docker-compose/filebrowser/filebrowser3-data/
/docker-compose/homarr/homarr/
/docker-compose/linkding/data/
/docker-compose/npm/data/
/docker-compose/npm/letsencrypt/
/docker-compose/paperless/consume/
/docker-compose/paperless/export/
/docker-compose/pihole/etc-pihole/
/docker-compose/pihole/etc-dnsmasq.d/
/docker-compose/plex/config/
/docker-compose/plex/movies/
/docker-compose/plex/tv/
